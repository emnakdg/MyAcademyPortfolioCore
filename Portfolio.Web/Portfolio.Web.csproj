<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\admin-template\**" />
    <Content Remove="wwwroot\admin-template\**" />
    <EmbeddedResource Remove="wwwroot\admin-template\**" />
    <None Remove="wwwroot\admin-template\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\MantisAdminTemplate\.DS_Store" />
    <None Include="wwwroot\MantisAdminTemplate\dist\.DS_Store" />
    <None Include="wwwroot\MantisAdminTemplate\src\.DS_Store" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0" />
  </ItemGroup>

</Project>

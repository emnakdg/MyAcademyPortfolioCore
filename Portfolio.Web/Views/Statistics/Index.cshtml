
@{
    ViewData["Title"] = "İstatistikler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
    <div class="col-md-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <h6 class="mb-2 f-w-400 text-muted">Proje Sayısı</h6>
                <h4 class="mb-3">
                    @ViewBag.ProjectCount
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <h6 class="mb-2 f-w-400 text-muted">Yetenek Ortalaması</h6>
                <h4 class="mb-3">
                    @ViewBag.SkillAverage%
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <h6 class="mb-2 f-w-400 text-muted">Okunmamış Mesaj Sayısı</h6>
                <h4 class="mb-3">
                    @ViewBag.UnreadMessageCount
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <h6 class="mb-2 f-w-400 text-muted">Son Mesaj Gönderen Kişi</h6>
                <h4 class="mb-3">
                    @ViewBag.LastMessageOwner
                </h4>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-primary">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.ExperienceYear</h3>
                <span class="m-t-10">Deneyim Yılı</span>
                <i class="ti ti-briefcase"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-info">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.CompanyCount</h3>
                <span class="m-t-10">Çalışılan Şirket Sayısı</span>
                <i class="ti ti-building"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-dark">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.ReviewAverage</h3>
                <span class="m-t-10">Değerlendirme Ortalamam</span>
                <i class="ti ti-star"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-danger">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.MaxReviewOwner</h3>
                <span class="m-t-10">En Yüksek Değerlendirme Yapan</span>
                <i class="ti ti-stars"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-primary">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.TestimonialCount</h3>
                <span class="m-t-10">Referans Sayısı</span>
                <i class="ti ti-man"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-info">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.EducationCount</h3>
                <span class="m-t-10">Alınan Eğitim Sayısı</span>
                <i class="ti ti-school"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-dark">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.projectCount</h3>
                <span class="m-t-10">Tamamlanan Projeler</span>
                <i class="ti ti-file-check"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card social-widget-card bg-danger">
            <div class="card-body">
                <h3 class="text-white m-0">@ViewBag.CategoryCount</h3>
                <span class="m-t-10">Kategori Sayısı</span>
                <i class="ti ti-files"></i>
            </div>
        </div>
    </div>
</div>




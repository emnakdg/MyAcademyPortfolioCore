@model List<ContactInfo>
@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-bordered table-hover">
    <tr>
        <th>Adres</th>
        <th>Telefon Numarası</th>
        <th>Email</th>
        <th>Map Url</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Address</td>
            <td>@item.PhoneNumber</td>
            <td>@item.Email</td>
            <td><iframe src="@item.MapUrl">Map URL</iframe></td>
            <td>
                <a href="/ContactInfo/UpdateContactInfo/@item.ContactInfoId" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>


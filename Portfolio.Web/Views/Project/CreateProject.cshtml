@model Project
@{
    ViewData["Title"] = "Yeni Proje Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <div class="form-group">
        <label>Proje Görsel Url</label>
        <input type="text" class="form-control" asp-for="ImageUrl">
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Proje Adı</label>
        <input type="text" class="form-control" asp-for="ProjectName">
        <span asp-validation-for="ProjectName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Proje Açıklaması</label>
        <textarea type="text" class="form-control" asp-for="Description" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Github Url</label>
        <input type="text" class="form-control" asp-for="GithubUrl">
        <span asp-validation-for="GithubUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Kategori</label>
        <select class="form-control" asp-for="CategoryId" asp-items="@ViewBag.categories">
            <option disabled selected>Kategori Seçiniz</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Kaydet</button>
</form>


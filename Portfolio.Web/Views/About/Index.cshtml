@model List<About>
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-bordered table-hover">
    <tr>
        <th>Resmim</th>
        <th>Rol</th>
        <th>Açıklama</th>
        <th>Doğum Yılı</th>
        <th>Kişisel Web Sitesi</th>
        <th>Telefon Numarası</th>
        <th>Şehir/Ülke</th>
        <th>Mezuniyet</th>
        <th>Email</th>
        <th>Müsaitlik</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><img src="@item.ImageUrl" style="height:75px;width:75px" />  </td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>@DateOnly.FromDateTime(@item.BirthDate)</td>
            <td>@item.WebSite</td>
            <td>@item.PhoneNumber</td>
            <td>@item.City</td>
            <td>@item.Graduation</td>
            <td>@item.Email</td>
            @if (@item.IsAvailable == true)
                {
                <td>
                    Müsait
                </td>
                }
                else
                {
                <td>
                    Müsait Değil
                </td>
                }
            
            <td>
                <a href="/About/UpdateAbout/@item.AboutId" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>


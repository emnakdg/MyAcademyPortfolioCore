@model About
@{
    ViewData["Title"] = "Hakkımda Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="AboutId" />
    <div class="form-group">
        <label>Kişisel Görsel Url</label>
        <input type="text" class="form-control" asp-for="ImageUrl">
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Rol</label>
        <input type="text" class="form-control" asp-for="Title">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Açıklama</label>
        <textarea type="text" class="form-control" asp-for="Description" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Doğum Yılı</label>
        <input type="date" class="form-control" asp-for="BirthDate">
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Kişisel web Sitesi</label>
        <input type="text" class="form-control" asp-for="WebSite">
        <span asp-validation-for="WebSite" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Telefon Numarası</label>
        <input type="text" class="form-control" asp-for="PhoneNumber">
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Şehir/Ülke</label>
        <input type="text" class="form-control" asp-for="City">
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Mezuniyet</label>
        <input type="text" class="form-control" asp-for="Graduation">
        <span asp-validation-for="Graduation" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" asp-for="Email">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Müsaitlik</label>
        <input type="checkbox" class="form-check-input" asp-for="IsAvailable">
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Güncelle</button>
</form>


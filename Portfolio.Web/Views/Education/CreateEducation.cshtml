@model Education
@{
    ViewData["Title"] = "Yeni Eğitim Bilgisi Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <div class="form-group">
        <label>Okul Adı</label>
        <input type="text" class="form-control" asp-for="SchoolName">
        <span asp-validation-for="SchoolName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Bölüm</label>
        <input type="text" class="form-control" asp-for="Department">
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Başlangıç Yılı</label>
        <textarea type="text" class="form-control" asp-for="StartYear" rows="3"></textarea>
        <span asp-validation-for="StartYear" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Bitiriş Yılı</label>
        <textarea type="text" class="form-control" asp-for="EndYear" rows="3"></textarea>
        <span asp-validation-for="EndYear" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Açıklama</label>
        <input type="text" class="form-control" asp-for="Description">
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Kaydet</button>
</form>


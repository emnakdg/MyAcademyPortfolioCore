@model Testimonial
@{
    ViewData["Title"] = "Referens Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="TestimonialId" />
    <div class="form-group">
        <label>Referans Görsel Url</label>
        <input type="text" class="form-control" asp-for="ImageUrl">
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Referans Adı</label>
        <input type="text" class="form-control" asp-for="Name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Rolü</label>
        <textarea type="text" class="form-control" asp-for="Title" rows="3"></textarea>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Yorum</label>
        <input type="text" class="form-control" asp-for="Comment">
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Değerlendirme Puanı</label>
        <input type="text" class="form-control" asp-for="Review">
        <span asp-validation-for="Review" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Güncelle</button>
</form>


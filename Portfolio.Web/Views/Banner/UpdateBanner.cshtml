@model Banner
@{
    ViewData["Title"] = "UpdateBanner";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="BannerId" />
    <div class="form-group">
        <label>Proje Görsel Url</label>
        <input type="text" class="form-control" asp-for="CoverImageUrl">
        <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Ad-Soyad</label>
        <input type="text" class="form-control" asp-for="NameSurname">
        <span asp-validation-for="NameSurname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Açıklama</label>
        <input type="text" class="form-control" asp-for="Title">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Güncelle</button>
</form>


@model Skill
@{
    ViewData["Title"] = "CreateSkill";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <div class="form-group">
        <label>Yetenek Adı</label>
        <input type="text" class="form-control" asp-for="Title">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Yüzde(Hakimlik)</label>
        <input type="text" class="form-control" asp-for="Percentage">
        <span asp-validation-for="Percentage" class="text-danger"></span>
    </div>

    <button class="btn btn-outline-primary">Kaydet</button>
</form>

